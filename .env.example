# Environment Configuration
NODE_ENV=development
PORT=3000

# MongoDB
MONGODB_URI=mongodb://localhost:27017/simaster_attendance

# JWT
JWT_SECRET=your_jwt_secret_key_here
JWT_EXPIRES_IN=7d

# LMS API Configuration
LMS_API_URL=https://your-lms-api.example.com
LMS_API_KEY=your_lms_api_key_here
LMS_API_SECRET=your_lms_api_secret_here

# CCTV / Face Recognition Service
FACE_RECOGNITION_API_URL=https://your-face-recognition-service.example.com
FACE_RECOGNITION_API_KEY=your_face_recognition_api_key_here

# Attendance Settings
ATTENDANCE_GRACE_PERIOD_MINUTES=15
FACE_MATCH_THRESHOLD=0.85
